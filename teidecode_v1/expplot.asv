% Sample Data Generation
numSeries = randi([30, 50]); % Randomly choose between 30 and 50 series
x = linspace(0, 10, 100); % X data (common for all series)
data = rand(100, numSeries); % Random Y data for each series

% Define colors and markers
colors = lines(numSeries); % Generate distinct colors
markers = {'o', 's', 'd', '^', 'v', 'p', 'h'}; % List of markers
numMarkers = length(markers);

% Create the plot
figure;
hold on; % Keep the current plot
for i = 1:numSeries
    % Determine the marker for the current series
    j = 1;
    mod(i)
    if mod(i,numMarkers) == 0
        j = j+1
    end
    marker = markers(j); % Loop through markers
    plot(x, data(:, i), 'Color', colors(i, :), 'Marker', marker, ...
        'DisplayName', sprintf('Series %d', i));
end

hold off; % Release the plot
xlabel('X-axis Label');
ylabel('Y-axis Label');
title('Multiple Series Plot');
legend('show'); % Show legend
grid on; % Add grid